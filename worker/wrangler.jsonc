{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arquibancada-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // Teto de requisições por dia (UTC). O plano Pro permite 7.500; a folga evita estourar.
    "DAILY_LIMIT": "7000",
    // Temporada do ranking de notas (players/toprated).
    "SEASON": "2026",
    "ALLOWED_ORIGINS": "https://gabrielguimah.com.br,http://gabrielguimah.com.br,https://gabrielguimah.github.io,http://localhost:4200",
    // Notificações de gol por push: chave pública do servidor (a privada é o segredo VAPID_PRIVATE_KEY)
    // e o contato que os serviços de push (Google, Apple, Mozilla) recebem.
    "VAPID_PUBLIC_KEY": "BPBtZ1D5G9-BambgG_IYtrJj3vr2UuXAcLprfLyo5hai_JVrlwvRkACAm4SwVFI4D9_486xV_z5VvmUPGe-qHZA",
    "VAPID_SUBJECT": "https://gabrielguimah.com.br/arquibancada/"
  },
  // Religa o acompanhamento dos gols (alarme do GoalPush) se ele parar.
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "API_CACHE", "class_name": "ApiCache" },
      { "name": "GOAL_PUSH", "class_name": "GoalPush" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApiCache"] },
    { "tag": "v2", "new_sqlite_classes": ["GoalPush"] }
  ]
}
